{
  "name": "mb-ai-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Micro Build AI 用户使用文档",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:types": "tsc --noEmit",
    "check:site": "node scripts/check-site.mjs",
    "check": "npm run check:types && npm run docs:build && npm run check:site"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitepress": "1.6.4"
  }
}
